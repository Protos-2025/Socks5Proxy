FROM alpine/jmeter:5 AS base

ENV JMETER_HOME=/opt/apache-jmeter-5.6.3
ENV PATH=${JMETER_HOME}/bin:${PATH}

# Install Java 17
RUN apk del openjdk8-jre
RUN apk add --no-cache openjdk17-jre

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk
ENV PATH="$JAVA_HOME/bin:$PATH"

RUN cd ${JMETER_HOME}/lib \
&& wget https://repo1.maven.org/maven2/kg/apc/cmdrunner/2.2/cmdrunner-2.2.jar

RUN cd ${JMETER_HOME}/lib/ext \
&& wget https://repo1.maven.org/maven2/kg/apc/jmeter-plugins-manager/1.6/jmeter-plugins-manager-1.6.jar

RUN cd ${JMETER_HOME}/bin \
&& java -cp ../lib/ext/jmeter-plugins-manager-1.6.jar org.jmeterplugins.repository.PluginManagerCMDInstaller \
&& ./PluginsManagerCMD.sh install jpgc-graphs-additional,jpgc-graphs-basic,jpgc-graphs-vs,jpgc-cmd

COPY bench/jmeter/user.properties ${JMETER_HOME}/bin/user.properties
